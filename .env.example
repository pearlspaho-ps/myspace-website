# Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables.
# Everything works without these; the forms just fall back as described in README.md.

# Friend comments + guestbook (supabase.com → your project → Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mail page sends without leaving the site (formspree.io → new form → the id after /f/)
VITE_FORMSPREE_ID=
